{
  "name": "@agentforge/cli",
  "version": "0.1.0",
  "description": "AgentForge developer CLI",
  "author": "AgentForge Contributors",
  "license": "Apache-2.0",
  "bin": {
    "agentforge": "./dist/index.js"
  },
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@agentforge/agent": "workspace:*",
